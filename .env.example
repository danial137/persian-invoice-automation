# Copy to .env and change the secrets before using outside localhost.
# The Docker database is exposed on 5433 to avoid Windows PostgreSQL conflicts.
DATABASE_URL="postgresql://invoice:invoice_dev_password@127.0.0.1:5433/invoices?schema=public"
POSTGRES_PORT=5433
POSTGRES_PASSWORD="invoice_dev_password"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_FOR_PRODUCTION"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe_123456!"
NEXT_PUBLIC_APP_NAME="حساب‌یار"
